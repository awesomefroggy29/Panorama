+/* ⛔★★★★★ WHICH 3D PIPELINE LEVELS TO CLAIM - THE THING DWM IS ASKING ABOUT.
+ *
+ * MEASURED 2026-08-18 (UMD 1.1.2.6, WDDM2_0 accepted, shaders translating
+ * cleanly): dwm opened the adapter **3757 times** and created **2** devices.
+ * The repeating unit is exactly three calls and ends without a CreateDevice:
+ *     OpenAdapter10_2(0x000b0011) -> GetCaps(3DPIPELINESUPPORT)=0x3 ->
+ *     GetSupportedVersions -> (abandon, no CloseAdapter) -> repeat
+ * i.e. dwm evaluates the pipeline level, rejects the adapter, and spins.
+ * `pan_device` was built ONCE across all 3757 opens, so the spin is cheap - but
+ * it means dwm never gets the device it wants.
+ *
+ * The level is the BIT INDEX (d3d10umddi.h:7293-7315):
+ *     _10_0=0 -> 0x1, _10_1=1 -> 0x2, _11_0=2 -> 0x4
+ * so 0x3 = 10_0|10_1 (what we claimed) and 0x7 adds 11_0.
+ *
+ * ⚠ Claiming 11_0 is NOT free: panfrost on this backend has NO geometry or
+ * tessellation hooks at all (zero create_gs_state/create_tcs_state/
+ * create_tes_state), so an 11_0 client may call things only our stubs answer.
+ * The stubs are safe-by-construction (log once, no-op, well-formed defaults),
+ * so the expected worst case is wrong rendering rather than a crash - but this
+ * is exactly the kind of claim that must be REVERSIBLE WITHOUT A REBUILD.
+ *
+ * Hence an env var, defaulting to the known-good 0x3. Set
+ * WINMALI_PIPELINE_LEVELS=7 to test 11_0; clear it to go straight back. */
+static UINT
+winmali_pipeline_levels(void)
+{
+   static int s_levels = -1;
+   if (s_levels < 0) {
+      const char *e = getenv("WINMALI_PIPELINE_LEVELS");
+      long v = (e && *e) ? strtol(e, NULL, 0) : 0;
+      /* ⛔★★ THE 9_x RUNGS WERE MISSING, AND THEY ARE FREE.
+       * The level is the BIT INDEX and the enum is NOT in ascending capability
+       * order: 10_0=0 10_1=1 11_0=2 11_1=3 **9_1=4 9_2=5 9_3=6** 12_0=7 12_1=8.
+       * So 0x3 claims 10_0|10_1 and silently claims NO 9_x level at all - any
+       * client that asks only for a 9_x device (a common low-power path for
+       * D2D/XAML) is refused and sent to WARP, for no reason: a driver that
+       * does 10_1 satisfies every 9_x requirement by construction.
+       * 0x73 = 9_1|9_2|9_3|10_0|10_1. 11_0 stays opt-in via the env var
+       * because panfrost has no geometry/tessellation hooks on this backend. */
+      s_levels = (v > 0) ? (int)v
+                         : (int)(D3D11DDI_ENCODE_3DPIPELINESUPPORT_CAP(D3D11DDI_3DPIPELINELEVEL_10_0) |
+                                 D3D11DDI_ENCODE_3DPIPELINESUPPORT_CAP(D3D11DDI_3DPIPELINELEVEL_10_1)
+#if D3D11DDI_MINOR_HEADER_VERSION >= 3
+                               | D3D11DDI_ENCODE_3DPIPELINESUPPORT_CAP(D3D11_1DDI_3DPIPELINELEVEL_9_1)
+                               | D3D11DDI_ENCODE_3DPIPELINESUPPORT_CAP(D3D11_1DDI_3DPIPELINELEVEL_9_2)
+                               | D3D11DDI_ENCODE_3DPIPELINESUPPORT_CAP(D3D11_1DDI_3DPIPELINELEVEL_9_3)
+#endif
+                                 );
+      mesa_loge("wm: WMDDIFL1 3DPIPELINESUPPORT will report 0x%x%s",
+                (unsigned)s_levels,
+                (v > 0) ? " (from WINMALI_PIPELINE_LEVELS)" : " (default 10_0|10_1)");
+   }
+   return (UINT)s_levels;
