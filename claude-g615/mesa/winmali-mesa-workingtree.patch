+               mesa_loge("panfrost_resource_copy_region: dst row %u is beyond "
+                         "the BO (%llu rows of %llu B, offset %llu) - dropping",
+                         dsty, (unsigned long long)rows_avail,
+                         (unsigned long long)stride,
+                         (unsigned long long)offset);
+               return;
+            }
+            if ((uint64_t)dsty + box.height > rows_avail) {
+               /* ⚠ THE ROW COUNT ALONE CANNOT SAY WHICH SIDE IS WRONG.
+                * "BO holds 262 rows" is consistent with a too-small BO, a
+                * too-large stride, or a dst whose declared height never matched
+                * its allocation - three different bugs. Print every input to
+                * rows_avail plus the destination's own geometry, so one line
+                * settles it instead of inviting a guess. */
+               mesa_loge("panfrost_resource_copy_region: clamping copy height "
+                         "%d -> %llu at dst row %u | rows_avail=%llu "
+                         "bo_size=%llu offset=%llu stride=%llu | dst %ux%u fmt=%u "
+                         "level=%u | stride implies width=%llu px @4B",
+                         box.height,
+                         (unsigned long long)(rows_avail - dsty), dsty,
+                         (unsigned long long)rows_avail,
+                         (unsigned long long)bo_size,
+                         (unsigned long long)offset,
+                         (unsigned long long)stride,
+                         dst->width0, dst->height0, (unsigned)dst->format,
+                         dst_level,
+                         (unsigned long long)(stride / 4));
+               box.height = (int)(rows_avail - dsty);
+            }
+         }
+      }
+
+      /* ⛔ THE DESTINATION CLAMP ABOVE IS ONLY HALF THE BOUND - AND THE MISSING
+       * HALF CRASH-LOOPED THE SHELL.
+       *
+       * util_copy_rect READS box.height rows from the SOURCE as well as writing
+       * them to the destination, and nothing here bounded the source. Measured
+       * 2026-08-16 with the dxgk-native path live: Explorer.EXE and
+       * StartMenuExperienceHost died repeatedly with c0000005 inside
+       * WinMaliUmd.dll, symbolising to memmove_unaligned called from this
+       * function, plus c0000374 (HEAP CORRUPTION) in dwm.exe and LogonUI.exe -
+       * the signature of a copy running past the end of a mapping.
+       *
+       * It only became reachable once imported surfaces started ADOPTING a real
+       * CPU VA: before that bo_map_cpu refused them and the copy was dropped, so
+       * the missing bound could never fire. Fixing one thing exposed the next -
+       * the same shape as the fence fix exposing the infinite wait.
+       *
+       * Bound the extent by BOTH ends before handing it to util_copy_rect. */
+      {
+         struct panfrost_resource *psrc = pan_resource(src);
+
+         /* Same union trap as the destination above - see that comment. The
+          * source is where it actually bit: LogonUI's AFBC surface was clamped
+          * to 52.9% of its height on every single frame. Bound by the extent
+          * always; only trust row_stride_B when the image is linear. */
+         if (src->target != PIPE_BUFFER) {
+            unsigned srcRows = u_minify(src->height0, src_level);
+
+            if ((unsigned)box.y >= srcRows) {
+               mesa_loge("panfrost_resource_copy_region: src row %d is beyond "
+                         "the source extent (%u rows) - dropping", box.y, srcRows);
+               return;
+            }
+            if ((uint64_t)box.y + box.height > srcRows)
+               box.height = (int)(srcRows - (uint64_t)box.y);
+         }
+
+         if (psrc->image.props.modifier == DRM_FORMAT_MOD_LINEAR &&
+             src->target != PIPE_BUFFER && psrc->bo != NULL) {
+            uint64_t sbo    = panfrost_bo_size(psrc->bo);
+            uint64_t soff   = psrc->plane.layout.slices[src_level].offset_B;
+            uint64_t sstr   =
+               psrc->plane.layout.slices[src_level].tiled_or_linear.row_stride_B;
+
+            if (sstr != 0 && sbo > soff) {
+               uint64_t srows = (sbo - soff) / sstr;
+
+               if ((uint64_t)box.y >= srows) {
+                  mesa_loge("panfrost_resource_copy_region: src row %d is beyond "
+                            "the source BO (%llu rows of %llu B) - dropping",
+                            box.y, (unsigned long long)srows,
+                            (unsigned long long)sstr);
+                  return;
+               }
+               if ((uint64_t)box.y + box.height > srows) {
+                  mesa_loge("panfrost_resource_copy_region: clamping height %d -> "
+                            "%llu at src row %d | src bo=%llu off=%llu stride=%llu "
+                            "%ux%u  (READ overrun - this is what crashed the shell)",
+                            box.height, (unsigned long long)(srows - box.y), box.y,
+                            (unsigned long long)sbo, (unsigned long long)soff,
+                            (unsigned long long)sstr, src->width0, src->height0);
+
+                  /* ★ WHY IS THE LAYOUT WIDER THAN THE BUFFER IT DESCRIBES?
+                   *
+                   * Measured 2026-08-17 off LogonUI: a 2946x1842 BGRA8 surface
+                   * reported row_stride_B=24576 over a 23,961,600 B BO - exactly
+                   * 975 rows where the copy wanted 1842. 975/1842 = 52.9%, which
+                   * is the "50-60% of the screen paints" the panel has shown all
+                   * session. The KMD is not at fault: it copies every row it is
+                   * given, and the rows below ~974 were simply never written.
+                   *
+                   * DXGI format 87 maps to PIPE_FORMAT_B8G8R8A8_UNORM (4 B), so a
+                   * doubled bpp is NOT the source of the doubled stride - it has
+                   * to come from the image's own props, which nothing here has
+                   * ever printed. Dump them rather than deduce them; rate-limited
+                   * because this fires every frame. */
+                  {
+                     static unsigned dumped = 0;
+                     if (dumped < 3) {
+                        unsigned bpp =
+                           util_format_get_blocksize(psrc->image.props.format);
+                        dumped++;
+                        mesa_loge("  ^ LAYOUT: modifier=0x%llx fmt=%u bpp=%u "
+                                  "extent=%ux%ux%u | slice.size_B=%llu "
+                                  "data_size_B=%llu array_stride_B=%llu | a linear "
+                                  "stride for that extent would be %u (x%.2f) | "
+                                  "rows needed=%d have=%llu",
+                                  (unsigned long long)psrc->image.props.modifier,
+                                  (unsigned)psrc->image.props.format, bpp,
+                                  psrc->image.props.extent_px.width,
+                                  psrc->image.props.extent_px.height,
+                                  psrc->image.props.extent_px.depth,
+                                  (unsigned long long)
+                                     psrc->plane.layout.slices[src_level].size_B,
+                                  (unsigned long long)psrc->plane.layout.data_size_B,
+                                  (unsigned long long)psrc->plane.layout.array_stride_B,
+                                  psrc->image.props.extent_px.width * bpp,
+                                  (double)sstr /
+                                     (double)(psrc->image.props.extent_px.width * bpp),
+                                  box.y + box.height, (unsigned long long)srows);
+                     }
+                  }
+
+                  box.height = (int)(srows - (uint64_t)box.y);
+               }
+            }
+         }
+      }
+
+      if (box.width <= 0 || box.height <= 0 || box.depth <= 0)
+         return;
+
+      util_resource_copy_region(pctx, dst, dst_level, dstx, dsty, dstz, src,
+                                src_level, &box);
+      return;
+   }
+
+   struct pipe_blit_info blit = {0};
+
+   blit.src.resource = src;
+   blit.src.level = src_level;
+   blit.src.format = src->format;
+   blit.src.box = *src_box;
+
+   blit.dst.resource = dst;
+   blit.dst.level = dst_level;
+   blit.dst.format = dst->format;
+   blit.dst.box.x = dstx;
+   blit.dst.box.y = dsty;
+   blit.dst.box.z = dstz;
+   blit.dst.box.width = src_box->width;
+   blit.dst.box.height = src_box->height;
+   blit.dst.box.depth = src_box->depth;
+
+   blit.mask = util_format_get_mask(dst->format);
+   blit.filter = PIPE_TEX_FILTER_NEAREST;
+
+   /* ⛔ MUST CHECK FIRST. panfrost_blit() does
+    *      if (!util_blitter_is_blit_supported(...)) UNREACHABLE("Unsupported blit")
+    * and UNREACHABLE is __builtin_unreachable() in a release build - undefined
+    * behaviour, not a clean failure, with no WER exception record to symbolize.
+    * Routing an unsupported copy in here would trade a diagnosable crash for an
+    * undiagnosable one. */
+   if (!util_blitter_is_blit_supported(pan_context(pctx)->blitter, &blit)) {
+      util_resource_copy_region(pctx, dst, dst_level, dstx, dsty, dstz, src,
+                                src_level, src_box);
+      return;
+   }
+
+   panfrost_blit(pctx, &blit);
+}
