+/* ⛔★★★★★ MEASUREMENT SCAFFOLD - "WHICH DDI VERSION DOES DWM ACTUALLY WANT?"
+ *
+ * WHY THIS EXISTS: dwm composites on WARP, not Mali. Measured 2026-08-18 on a
+ * clean boot: dwm burns ~5% CPU continuously with its mesa log FROZEN, holding
+ * d3d11.dll + d3d10warp.dll + Microsoft.Internal.WarpPal.dll. It never asks us
+ * for D3D11 - because SupportedDDIInterfaceVersions above advertises ONLY
+ * D3D10_0_*, so the runtime has nothing newer to ask for.
+ *
+ * ⚠ THE TRAP THIS AVOIDS: dwm's log contains ZERO "OpenAdapter10 REFUSING"
+ * lines, which reads like "we satisfied it". It is a TAUTOLOGY - you cannot
+ * refuse a version nobody requested. An absent refusal for a capability never
+ * advertised is not a measurement.
+ *
+ * The ladder is long (D3D11_0, D3D11_1, WDDM1_3, WDDM2_0..2_9, WDDM3_0/3_1 -
+ * d3d10umddi.h:7706-7965) and D3D11DDI_DEVICEFUNCS alone is 152 entries vs the
+ * 105 we already fill. Writing 152 function pointers for the WRONG rung would
+ * be wasted work, so: ADVERTISE the ladder, LOG what the runtime asks for, and
+ * still refuse to create the device. One boot tells us which table to write.
+ *
+ * ⚠ OFF BY DEFAULT and gated on an ENV VAR, not a rebuild: if advertising a
+ * version we cannot honour regresses the currently-working D3D10 path (explorer
+ * renders on Mali today), the fix is to clear the variable and reboot - no
+ * build, no deploy, no driver reinstall. Same read-once-and-cache pattern as
+ * winmali_use_dxgk_fences(). */
+static bool
+winmali_advertise_full_ladder(void)
+{
+   static int s_on = -1;
+   if (s_on < 0) {
+      const char *e = getenv("WINMALI_ADVERTISE_LADDER");
+      s_on = (e && *e && *e != '0') ? 1 : 0;
+      mesa_loge("wm: DDI ladder advertisement = %s",
+                s_on ? "FULL (measurement mode - device creation will still "
+                       "be refused above D3D10_0)"
+                     : "D3D10_0 only (default)");
+   }
+   return s_on != 0;
+}
+
+/* ⛔★★★★★ RUNTIME KILL SWITCH FOR WDDM2_0 ACCEPTANCE.
+ *
+ * SUPPORT_WDDM2_0 is a compile-time switch, which is the wrong granularity for
+ * the first hardware trial: if accepting 0x000b0011 breaks logon, a compile-time
+ * flag means a rebuild + deploy + reboot to get back, and if the desktop is dead
+ * that is a physical recovery.
+ *
+ * So the version is only ACCEPTED when WINMALI_WDDM2_0=1 is set machine-wide.
+ * Default OFF = today's behaviour exactly (refuse, client falls back as before).
+ * WinRM keeps working with or without a usable desktop, so the switch can always
+ * be cleared remotely and the box rebooted back to a known state.
+ *
+ * Read once and cached, same pattern as winmali_use_dxgk_fences(). */
+static bool
+winmali_wddm20_enabled(void)
+{
+   static int s_on = -1;
+   if (s_on < 0) {
+      const char *e = getenv("WINMALI_WDDM2_0");
+      s_on = (e && *e && *e != '0') ? 1 : 0;
+      mesa_loge("wm: WMDDIGATE1 WDDM2_0 acceptance = %s",
+                s_on ? "ENABLED (interface 0x000b0011 will be accepted)"
+                     : "disabled (default) - set WINMALI_WDDM2_0=1 to try it");
+   }
+   return s_on != 0;
+}
