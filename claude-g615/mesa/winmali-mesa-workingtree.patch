+   simple_mtx_lock(&g_kmt_alloc_ids.lock);
+   for (uint32_t i = 0; i < g_kmt_alloc_ids.count; i++) {
+      if (g_kmt_alloc_ids.ent[i].kmt == kmt) {
+         *cpu  = g_kmt_alloc_ids.ent[i].cpu;
+         *size = g_kmt_alloc_ids.ent[i].size;
