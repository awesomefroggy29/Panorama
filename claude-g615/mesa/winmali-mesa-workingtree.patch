+   if (kmt == 0)
+      return 0;
+
+   simple_mtx_lock(&g_kmt_ids.lock);
+   for (uint32_t i = 0; i < g_kmt_ids.count; i++) {
+      if (g_kmt_ids.ent[i].kmt == kmt) {
+         h = g_kmt_ids.ent[i].handle;
+         break;
+      }
+   }
+   simple_mtx_unlock(&g_kmt_ids.lock);
+   return h;
