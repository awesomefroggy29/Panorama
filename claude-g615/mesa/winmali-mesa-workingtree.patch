+      if (DstX >= dw || DstY >= dh || (DstZ + dst_layer) >= dd ||
+          src_box.x >= (int)sw || src_box.y >= (int)sh) {
+         mesa_loge("ResourceCopyRegion: destination/source origin outside the "
+                   "resource (dst %ux%ux%u at %u,%u,%u; src %ux%u at %d,%d) - "
+                   "dropping the copy",
+                   dw, dh, dd, DstX, DstY, DstZ + dst_layer,
+                   sw, sh, src_box.x, src_box.y);
+         return;
+      }
+
+      /* Shrink the extent to whatever actually fits in BOTH resources. */
+      src_box.width  = MIN3((unsigned)src_box.width,  dw - DstX, sw - src_box.x);
+      src_box.height = MIN3((unsigned)src_box.height, dh - DstY, sh - src_box.y);
+      src_box.depth  = MIN2((unsigned)src_box.depth,  sd - (unsigned)(src_box.z - src_layer));
+
+      if (src_box.width <= 0 || src_box.height <= 0 || src_box.depth <= 0)
+         return;
+   }
+
    if (areResourcesCompatible(src_resource, dst_resource)) {
       pipe->resource_copy_region(pipe,
                                  dst_resource, dst_level,
@@ -959,11 +1586,45 @@ ResourceCopyRegion(D3D10DDI_HDEVICE hDevice,                // IN
                                  src_resource, src_level,
                                  &src_box);
    } else {
-      util_resource_copy_region(pipe,
-                                dst_resource, dst_level,
-                                DstX, DstY, DstZ + dst_layer,
-                                src_resource, src_level,
-                                &src_box);
+      /* ★ FORMAT-CONVERTING COPY: BLIT ON THE GPU, DO NOT COPY ON THE CPU.
+       *
+       * util_resource_copy_region() maps both resources and runs
+       * util_copy_box -> util_copy_rect, which walks rows using
+       * transfer->stride with NO bounds check against the mapping it was given.
+       * SYMBOLIZED TWICE from LogonUI full dumps (c0000005 writing x0 in
+       * util_copy_rect, u_format.c:93, x2=0x60 then 0x188) - the last row lands
+       * one page past the destination. Clamping the BOX did not help, which
+       * proves the box was already in range and the DESTINATION MAPPING is what
+       * is short.
+       *
+       * A blit sidesteps the whole CPU mapping path, and is what this should
+       * have been doing anyway: panfrost converts formats on the GPU far faster
+       * than a per-row memcpy. Only the CPU fallback was ever crashing.
+       *
+       * Stakes: autologon fires ONCE, so a single LogonUI fault parks the
+       * machine at the logon screen with a black panel for the entire boot. */
+      struct pipe_blit_info blit;
+      memset(&blit, 0, sizeof blit);
+
+      blit.src.resource = src_resource;
+      blit.src.level    = src_level;
+      blit.src.format   = src_resource->format;
+      blit.src.box      = src_box;
+
+      blit.dst.resource = dst_resource;
+      blit.dst.level    = dst_level;
+      blit.dst.format   = dst_resource->format;
+      blit.dst.box.x      = DstX;
+      blit.dst.box.y      = DstY;
+      blit.dst.box.z      = DstZ + dst_layer;
+      blit.dst.box.width  = src_box.width;
+      blit.dst.box.height = src_box.height;
+      blit.dst.box.depth  = src_box.depth;
+
+      blit.mask   = PIPE_MASK_RGBA;
+      blit.filter = PIPE_TEX_FILTER_NEAREST;
+
+      pipe->blit(pipe, &blit);
    }
 }
 
