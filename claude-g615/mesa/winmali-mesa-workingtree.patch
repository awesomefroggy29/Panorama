+/* Declare an enum whose underlying type is exactly one byte.
+ *
+ * Prefer this over `enum ENUM_PACKED foo` for enums used as members of a struct
+ * that asserts it has no padding. clang targeting the MSVC ABI SILENTLY ignores
+ * __attribute__((packed)) on an *enum* — sizeof stays 4 and no diagnostic is
+ * emitted, in both -fms-compatibility modes — but it does honour an explicit
+ * fixed underlying type. (Struct-level __attribute__((packed)) *is* honoured,
+ * so PACKED above is fine; only the enum case is dropped.)
+ *
+ * This matters beyond a size regression: the no-padding assertions guard
+ * structs that get hashed or memcmp'd as cache keys, where padding bytes are
+ * indeterminate.
+ *
+ * Every other target keeps the attribute spelling, so nothing else changes.
+ */
+#if defined(__clang__) && defined(_MSC_VER)
+#  define ENUM_U8(name) enum name : uint8_t
+#else
+#  define ENUM_U8(name) enum ENUM_PACKED name
+#endif
+
 /* Attribute pure is used for functions that have no effects other than their
  * return value.  As a result, calls to it can be dead code eliminated.
  */
