+   g_kmt_alloc_ids.ent[g_kmt_alloc_ids.count].cpu  = cpu;
+   g_kmt_alloc_ids.ent[g_kmt_alloc_ids.count].size = size;
+   g_kmt_alloc_ids.ent[g_kmt_alloc_ids.count].pitch = pitch;
